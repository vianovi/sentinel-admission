# Application
APP_NAME="Al-Muntaha School"
APP_TAGLINE="Menuju Puncak Ilmu & Akhlak"
APP_LOGO="/assets/icons/brand/logo.webp"
EMAIL_LOGO="/assets/icons/brand/logo-email.png"
EMAIL_PROGRAM_TITLE="Sistem Penerimaan Santri Baru"
EMAIL_ACADEMIC_YEAR="2027/2028"
EMAIL_COPYRIGHT_YEAR="2027"
EMAIL_WHATSAPP="085111223344 -> Admin SPMB"
EMAIL_WEBSITE_URL="https://spmb.playground-ku.my.id"
EMAIL_VALIDATE_MX=true
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Security and logging
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mariadb
DB_HOST=172.17.0.1
DB_PORT=3306
DB_DATABASE=sentinel_admission_db
DB_USERNAME=your-local-database-username
DB_PASSWORD=your-local-database-password

# Session, queue, cache, and storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

# Mailtrap Email Sandbox
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-sandbox-username
MAIL_PASSWORD=your-mailtrap-sandbox-password
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="noreply@sentinel-admission.test"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false

# Frontend and HTTPS
VITE_APP_NAME="${APP_NAME}"
FORCE_HTTPS=false
