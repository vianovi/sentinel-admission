APP_NAME="Al-Muntaha School"
APP_TAGLINE="Menuju Puncak Ilmu & Akhlak"
APP_LOGO="/assets/icons/brand/logo.webp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admission.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Security and logging
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mariadb
DB_HOST=your-production-database-host
DB_PORT=3306
DB_DATABASE=sentinel_admission_db
DB_USERNAME=your-production-database-username
DB_PASSWORD=your-production-database-password

# Session, queue, cache, and storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Resend SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=your-resend-api-key
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="noreply@mail.your-verified-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans Production
MIDTRANS_SERVER_KEY=your-midtrans-production-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-production-client-key
MIDTRANS_IS_PRODUCTION=true

# Frontend and HTTPS
FORCE_HTTPS=true
VITE_APP_NAME="${APP_NAME}"

# Broadcasting & Reverb WebSockets
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=your-reverb-app-id
REVERB_APP_KEY=your-reverb-app-key
REVERB_APP_SECRET=your-reverb-app-secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8085
REVERB_SERVER_PORT=8085
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="admission.example.com"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
