APP_NAME="Al-Muntaha School"
APP_TAGLINE="Menuju Puncak Ilmu & Akhlak"
APP_LOGO="/assets/icons/brand/logo.webp"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Security and logging
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Session, queue, cache, and storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Resend SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=your-resend-api-key
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="noreply@mail.your-verified-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false

# Frontend and HTTPS
FORCE_HTTPS=true
VITE_APP_NAME="${APP_NAME}"
